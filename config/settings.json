{
  "scraper_version": "1.0.0",
  "graphql_endpoint": "https://api.github.com/graphql",
  "request_timeout_seconds": 30,
  "max_retries": 4,
  "retry_base_delay_seconds": 1.0,
  "rate_limit_warning_threshold": 500,
  "rate_limit_wait_enabled": true,
  "rate_limit_max_wait_seconds": 3600,
  "pr_page_size": 100,
  "commit_page_size": 100,
  "max_commits_per_pr": 100,
  "impact_min_changed_files": 3,
  "repository_storage_directory": "data/repositories",
  "analysis_output_directory": "data/analysis",
  "clone_timeout_seconds": 600,
  "static_analysis": {
    "include_tests": false,
    "max_python_files_per_repository": 10000,
    "excluded_directory_names": [
      ".git", ".venv", "venv", "env", "__pycache__", ".tox", ".nox",
      "build", "dist", "node_modules", ".mypy_cache", ".pytest_cache",
      "docs", "doc", "examples", "benchmarks"
    ],
    "excluded_file_names": ["setup.py", "conftest.py"]
  },
  "semantic_keywords": [
    "refactor", "refactoring", "architecture", "architectural",
    "circular import", "circular dependency", "decouple", "decoupling"
  ]
}

